FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=attrisense-secret-change-in-production

# Database (SQLite for dev, swap for PostgreSQL in prod)
DATABASE_URL=sqlite:///attrisense.db

# JWT
JWT_SECRET_KEY=attrisense-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=604800

# CORS — your Vite frontend
CORS_ORIGINS=http://localhost:5173

# CSV dataset path (relative to project root)
CSV_PATH=data/attrition_predictions.csv
